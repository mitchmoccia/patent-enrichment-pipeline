# Patent Enrichment Platform — environment template
#
# Copy to `.env` and fill in per-environment values. NEVER commit real secrets.
# The application shell (S00) boots with everything below unset; each integration
# is activated and verified in its own build slice. A value that is present but
# malformed produces a clear configuration error (see `pnpm check:env`).

# Runtime
NODE_ENV=development

# --- Persistence: Neon Postgres (S01/S03) ---
# Scoped, non-owner application role (RLS enforced):
DATABASE_URL=
# Separate privileged migration role:
DATABASE_MIGRATION_URL=

# --- Authentication: Better Auth (S01) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Private artifact storage: S3 + KMS (S02) ---
S3_BUCKET=
S3_REGION=
KMS_KEY_ID=

# --- Document workers (S02/S03) ---
WORKER_CALLBACK_SECRET=

# --- Model routes: AI Gateway / provider (S04+) ---
AI_GATEWAY_API_KEY=

# --- Research source providers (S06) ---
USPTO_API_KEY=
EPO_OPS_KEY=

# --- Billing: Stripe (S15) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Analytics: PostHog, metadata only (S15) ---
POSTHOG_KEY=
POSTHOG_HOST=

# --- Telemetry: OpenTelemetry (S15/S16) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Legal rule-pack promotion signing (S05) ---
RULEPACK_SIGNING_KEY=
